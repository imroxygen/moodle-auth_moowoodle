{{!
    @template auth_moowoodle/summary

    The setup wizard's final Summary step: two read-only status tables and
    the buttons to finish or restart the wizard.

    Context variables required for this template:
    * heading - plain text step heading.
    * intro - plain text introduction paragraph.
    * generalheading - plain text sub-heading for the general settings table.
    * generalrows - array of {label, value}; value is pre-rendered HTML (e.g. an icon + text).
    * connectionheading - plain text sub-heading for the connection table.
    * connectionrows - array of {label, value}; value is pre-rendered HTML.
    * copynote - plain text note shown below the connection table.
    * gotosettingsbutton - pre-rendered HTML for the "Go to settings" button.
    * restartbutton - pre-rendered HTML for the "Restart wizard" button.

    Example context (json):
    {
        "heading": "Summary",
        "intro": "Review the configuration below.",
        "generalheading": "General settings summary",
        "generalrows": [ {"label": "Web services", "value": "Enabled"} ],
        "connectionheading": "Connection settings summary",
        "connectionrows": [ {"label": "Moodle URL", "value": "https://example.com"} ],
        "copynote": "Keep the secret key and access token private.",
        "gotosettingsbutton": "<div class=\"singlebutton\"><a href=\"#\">Go to settings</a></div>",
        "restartbutton": "<div class=\"singlebutton\"><a href=\"#\">Restart wizard</a></div>"
    }
}}
<h3>{{heading}}</h3>
<p>{{intro}}</p>

<h4>{{generalheading}}</h4>
<table class="table table-sm auth-moowoodle-summary-table">
    <tbody>
        {{#generalrows}}
        <tr>
            <td>{{label}}</td>
            <td>{{{value}}}</td>
        </tr>
        {{/generalrows}}
    </tbody>
</table>

<h4>{{connectionheading}}</h4>
<table class="table table-sm auth-moowoodle-summary-table">
    <tbody>
        {{#connectionrows}}
        <tr>
            <td>{{label}}</td>
            <td>{{{value}}}</td>
        </tr>
        {{/connectionrows}}
    </tbody>
</table>
<p>{{copynote}}</p>

{{{gotosettingsbutton}}}
{{{restartbutton}}}
